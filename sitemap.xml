---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign main_urls = '/,/about/,/research/,/projects/,/writing/,/life/,/en/,/en/about/,/en/research/,/en/projects/,/en/writing/,/en/life/,/archives/,/tags/' | split: ',' %}
{% for url in main_urls %}
  <url><loc>{{ url | absolute_url | xml_escape }}</loc></url>
{% endfor %}
{% assign project_urls = '/projects/wafer-scheduling/,/en/projects/wafer-scheduling/,/projects/process-optimization/,/en/projects/process-optimization/,/projects/production-scheduling/,/en/projects/production-scheduling/,/projects/photo-archive/,/en/projects/photo-archive/' | split: ',' %}
{% for project_url in project_urls %}<url><loc>{{ project_url | absolute_url | xml_escape }}</loc></url>{% endfor %}
{% for post in site.posts %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc><lastmod>{{ post.date | date: '%Y-%m-%d' }}</lastmod></url>
{% endfor %}
</urlset>
